<?xml version="1.0" ?>
<sdf version="1.8">
    <world name="empty">
        <!-- Базовая физика и свет пустого мира -->
        <physics name="1ms" type="ignored">
            <max_step_size>0.001</max_step_size>
            <real_time_factor>1.0</real_time_factor>
        </physics>
        <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics" />
        <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands" />
        <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster" />

        <light type="directional" name="sun">
            <cast_shadows>true</cast_shadows>
            <pose>0 0 10 0 0 0</pose>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.2 0.2 0.2 1</specular>
            <attenuation><range>1000</range><constant>0.9</constant><linear>0.01</linear><quadratic>0.001</quadratic></attenuation>
            <direction>-0.5 0.1 -0.9</direction>
        </light>

        <model name="ground_plane">
            <static>true</static>
            <link name="link">
                <collision name="collision">
                    <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
                </collision>
                <visual name="visual">
                    <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
                    <material><ambient>0.8 0.8 0.8 1</ambient><diffuse>0.8 0.8 0.8 1</diffuse><specular>0.8 0.8 0.8 1</specular></material>
                </visual>
            </link>
        </model>

        <!-- ПРИНУДИТЕЛЬНОЕ ПОДКЛЮЧЕНИЕ ПРИВОДА К РОБОТУ ЧЕРЕЗ МИР -->
        <plugin filename="gz-sim-skid-steer-drive-system" name="gz::sim::systems::SkidSteerDrive">
            <left_front_joint>my_robot::wheel_front_left_joint</left_front_joint>
            <right_front_joint>my_robot::wheel_front_right_joint</right_front_joint>
            <left_rear_joint>my_robot::wheel_back_left_joint</left_rear_joint>
            <right_rear_joint>my_robot::wheel_back_right_joint</right_rear_joint>
            <wheel_separation>0.4</wheel_separation>
            <wheel_radius>0.0762</wheel_radius>
            <topic>/cmd_vel</topic>
            <odom_topic>/odom</odom_topic>
        </plugin>
    </world>
</sdf>
